{
  "version": 9,
  "include": ["CMakeUserEnv.json"],
  "configurePresets": [
    {
      "name": "static",
      "hidden": false,
      "inherits": [ "user_clang_paths" ],
      "generator": "Ninja",
      "description": "Default staticly build",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "$env{USER_CLANG_20_PATH}",
        "CMAKE_CXX_COMPILER": "$env{USER_CLANG++_20_PATH}"
      }
    },
    {
      "inherits": [ "static" ],
      "name": "hotreload",
      "hidden": false,
      "generator": "Ninja",
      "description": "Default dev build: hot reload + Tracy (shared TracyClient.dll)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HOT_RELOAD": "ON",
        "TRACY_ENABLE": "ON",
        "TRACY_ON_DEMAND": "ON",
        "TRACY_BUILD_SERVER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "static",
      "configurePreset": "static"
    },
    {
      "name": "hotreload",
      "configurePreset": "hotreload"
    }
    
  ],
  "testPresets": [
    {
      "name": "Test",
      "configurePreset": "static"
    }
  ]
}